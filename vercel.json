{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.js" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/products", "destination": "/products.html" },
    { "source": "/product", "destination": "/product.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/request-demo", "destination": "/request-demo.html" },
    { "source": "/compare", "destination": "/compare.html" },
    { "source": "/resources", "destination": "/resources.html" },
    { "source": "/roi-calculator", "destination": "/roi-calculator.html" },
    { "source": "/support", "destination": "/support.html" },
    { "source": "/docs", "destination": "/docs.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/admin", "destination": "/admin.html" }
  ]
}
